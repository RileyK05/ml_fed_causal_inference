# Model runs are tracked (manifests, metrics, aggregate tables, weights) so they can be viewed
# anywhere. Per-firm prediction tables are not: they carry CRSP ids and returns (licensed WRDS data).
core/results/
**/results/**/predictions.csv

# WRDS data is licensed: never commit it. Re-pull with python -m fedcore.ingest.wrds pull.
core/data/raw/wrds/
core/data/raw/wrds_top1500/
# Q3 panel built from WRDS data: licensed, rebuilt by fedcore.q3.real.load_real_panel().
core/data/processed/q3_panel/
core/data/processed/q3_panel_top1500/
# yfinance bars keyed by CRSP permno (licensed mapping). Re-pull: python -m fedcore.ingest.yf_firms pull
core/data/raw/yfinance_firms/
# 2026 holdout panel (CRSP history + yfinance): licensed inputs.
core/data/processed/q3_holdout/

# Local vast.ai helper scripts (host-specific; they move licensed WRDS data). Never commit.
vast_*.sh

# Free sources keyed by licensed Compustat ids (gvkey, CIK list), and large raw downloads.
core/data/raw/hoberg_phillips/
core/data/interim/hoberg_phillips/
core/data/raw/edgar/
core/data/interim/edgar/
core/data/raw/frb_gsw/
# Q3 channel table built from WRDS data: licensed, rebuilt by fedcore.q3.channels.load_channels().
core/data/processed/q3_channels/
core/data/processed/q3_text/
core/data/processed/q3_shock_panel/
core/data/processed/q3_filing_vectors/
